# Copy to .env. Empty values keep the defaults documented in SETUP.md.
# pnpm dev loads this file.

# --- process ---
SIGNALING_HOST=0.0.0.0
SIGNALING_PORT=7880
WEB_PUBLIC_DIR=apps/web/public
# Uncomment to require Authorization: Bearer on POST /tokens and GET /stats.
# API_KEY=
# Required outside local development. The default is a published insecure string.
# JWT_SECRET=
# Uncomment to allow /admin from anywhere. Otherwise /admin answers only on localhost.
# ADMIN_API_KEY=
SETTINGS_FILE=data/settings.json
# JSON array of RTCIceServer objects, for example:
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
ICE_SERVERS=[]

# --- media workers ---
WORKER_BINARY=build/native/sfu-worker
# WORKER_COUNT=3
WORKER_PIN_CPUS=true
# Leave unset for local use. When ANNOUNCED_IP is 127.0.0.1 the worker binds there.
# Set 0.0.0.0 only when ANNOUNCED_IP is an address other machines use.
# MEDIA_BIND_IP=0.0.0.0
MEDIA_PORT_BASE=40000
# Address browsers send UDP to. Use this machine's reachable IP for remote callers.
ANNOUNCED_IP=127.0.0.1
VIDEO_CODECS=vp9,vp8
ROOM_EMPTY_TIMEOUT_SEC=10

# Worker tuning. Uncomment to override the worker's built-in default.
# AUDIO_LEVEL_THRESHOLD=55
# SURFACE_MS=1000
# MIN_TILE_MS=4000
# HANGOVER_MS=500
# QUEUE_MS=100
# PUBLISHER_KBPS=1000
# SUBSCRIBER_START_KBPS=1500
# SUBSCRIBER_MAX_KBPS=8000
# PARTICIPANT_TIMEOUT_MS=15000

# --- admission ---
CAPACITY_MBPS=900
VIDEO_TILE_KBPS=80
AUDIO_KBPS=40
AVG_SPEAKERS=1.5

# --- recording ---
# Starting value only. /admin saves over it in SETTINGS_FILE.
RECORDING_ENABLED=true
RECORDINGS_DIR=recordings
RECORDING_MIN_FREE_GB=10
CLEANUP_WATERMARK_GB=30
CLEANUP_TIME=02:00
CLEANUP_MAX_MBPS=200
FFMPEG_PATH=ffmpeg

# Upload stays off until S3_BUCKET is set.
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=recordings/
# S3_FORCE_PATH_STYLE=true
